# Empty values disable outbound integrations.
# Browser-visible Vapi public key only: NEVER insert a private API key here.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Server-only webhook URL and shared secret. Authenticate at n8n too.
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_SECRET=
N8N_ALERT_WEBHOOK_URL=
VAPI_SERVER_SECRET=

# Optional analytics is off by default.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
